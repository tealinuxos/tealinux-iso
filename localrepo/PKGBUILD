# This is an example PKGBUILD file. Use this as a start to creating your own,
# and remove these comments. For more information, see 'man PKGBUILD'.
# NOTE: Please fill out the license field for your package! If it is unknown,
# then please put 'unknown'.

# Maintainer: Gagah Syuja <gghssa1@gmail.com>
packager="Gagah Syuja <gghssa1@gmail.com>"
pkgname=tealinux-installer-git
pkgver=2.0
pkgrel=1
pkgdesc="TealinuxOS Installer, written in Tauri|Rust|SvelteKit."
arch=("x86_64")
url="https://github.com/tealinuxos/tealinux-installer.git"
license=('GPL')
depends=("webkit2gtk-4.1")
makedepends=("grub" "rust" "bun")
source=(
    "tealinux-installer-src::git+https://github.com/tealinuxos/tealinux-installer.git"
    "${pkgname}.desktop"
)
sha256sums=(
    'SKIP'
    '57ecffa5b991947fa4eb575d7ffd7ee7f9e3c870065c0878c99747a0e41311c6'
)

build() {
    cd "${srcdir}/tealinux-installer-src"

    # Patch brotli crate: fix alloc-no-stdlib version mismatch (v2.0 vs v3.0)
    # brotli 8.0.3 specifies alloc-no-stdlib = "2.0" but its sub-deps use v3.0.0,
    # causing E0277 trait mismatch errors on Rust 1.96+
    _brotli_src=$(find "$HOME/.cargo/registry/src" -maxdepth 1 -name 'index.crates.io-*' -print -quit)/brotli-8.0.3
    if [ -d "$_brotli_src" ]; then
        cp -r "$_brotli_src" src-tauri/brotli-patched
    else
        # Fetch it first so it's in the registry cache
        cd src-tauri && cargo fetch && cd ..
        _brotli_src=$(find "$HOME/.cargo/registry/src" -maxdepth 1 -name 'index.crates.io-*' -print -quit)/brotli-8.0.3
        cp -r "$_brotli_src" src-tauri/brotli-patched
    fi
    sed -i 's/^version = "2\.0"$/version = "3.0"/' src-tauri/brotli-patched/Cargo.toml

    # Add patch section to Cargo.toml if not present
    if ! grep -q '\[patch.crates-io\]' src-tauri/Cargo.toml; then
        printf '\n[patch.crates-io]\nbrotli = { path = "brotli-patched" }\n' >> src-tauri/Cargo.toml
    fi

    bun install
    TEALINUX_BUILD=prod bun run tauri build --no-bundle
}

package() {
    install -Dm755 "${srcdir}/tealinux-installer-src/src-tauri/target/release/tealinux-installer" "${pkgdir}/usr/bin/tealinux-installer"

    install -D -m644 ${pkgname}.desktop ${pkgdir}/usr/share/applications/${pkgname}.desktop
#     install -D -m644 ${pkgname}.desktop ${pkgdir}/etc/xdg/autostart/${pkgname}.desktop
}
