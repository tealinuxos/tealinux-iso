# Maintainer: Fadhil Riyanto <me@fadev.org>

packager="Fadhil Riyanto <me@fadev.org>"
pkgname=tealinux-modularity-git
pkgver=1.0
pkgrel=1
pkgdesc="A utility and helper for TealinuxOS in one-place"
arch=("x86_64")
url="https://github.com/tealinuxos/tealinux-modularity.git"
license=('GPL')
depends=("webkit2gtk-4.1" "fastfetch")
makedepends=("grub" "rust")
source=(
    "git+${url}"
    "${pkgname}.desktop"
)
sha256sums=(
    'SKIP'
    'd431b6c1983cc22c7523f20dba7b0dfd4387df78fc8151c06bac7b4091087bb5'
)

build() {
    CFLAGS+=' -ffat-lto-objects'
    rm -rf tealinux-modularitea-libs
    cd "${srcdir}" && git clone "https://github.com/tealinuxos/tealinux-modularitea-libs.git" 
    cd "${srcdir}/tealinux-modularity"
    bun install
    bun run tauri build --no-bundle
}

package() {
    install -Dm755 "${srcdir}/tealinux-modularity/src-tauri/target/release/tealinux-modularity" "${pkgdir}/usr/bin/tealinux-modularity"

    install -D -m644 ${pkgname}.desktop ${pkgdir}/usr/share/applications/${pkgname}.desktop
#     install -D -m644 ${pkgname}.desktop ${pkgdir}/etc/xdg/autostart/${pkgname}.desktop
}
