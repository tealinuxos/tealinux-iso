{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "~/.config/fastfetch/teaascii.txt",
      "padding": {
        "top": 2
      }
    },
    "display": {
      "separator": " ➜  "
    },
    "modules": [
      "break",
      "break",
      "break",
      {
        "type": "os",
        "key": "OS   ",
        "keyColor": "32"
      },
      {
        "type": "kernel",
        "key": " ├  ",
        "keyColor": "32"
      },
      {
        "type": "packages",
        "format": "{} (pacman)",
        "key": " ├ 󰏖 ",
        "keyColor": "32"
      },
      {
        "type": "shell",
        "key": " └  ",
        "keyColor": "32"
      },
      "break",
      {
        "type": "wm",
        "key": "WM   ",
        "keyColor": "32"
      },
      {
        "type": "wmtheme",
        "key": " ├ 󰉼 ",
        "keyColor": "32"
      },
      {
        "type": "icons",
        "key": " ├ 󰀻 ",
        "keyColor": "32"
      },
      {
        "type": "cursor",
        "key": " ├  ",
        "keyColor": "32"
      },
      {
        "type": "terminal",
        "key": " ├  ",
        "keyColor": "32"
      },
      {
        "type": "terminalfont",
        "key": " └  ",
        "keyColor": "32"
      },
      "break",
      {
        "type": "host",
        "format": "{5} {1} Type {2}",
        "key": "PC   ",
        "keyColor": "32"
      },
      {
        "type": "cpu",
        "format": "{1} ({3}) @ {7} GHz",
        "key": " ├  ",
        "keyColor": "32"
      },
      {
        "type": "gpu",
        "format": "{1} {2} @ {12} GHz",
        "key": " ├ 󰢮 ",
        "keyColor": "32"
      },
      {
        "type": "memory",
        "key": " ├  ",
        "keyColor": "32"
      },
      {
        "type": "swap",
        "key": " ├ 󰓡 ",
        "keyColor": "32"
      },
      {
        "type": "disk",
        "key": " ├ 󰋊 ",
        "keyColor": "32"
      },
      {
        "type": "monitor",
        "key": " └  ",
        "keyColor": "32"
      },
      "break",
      "break"
    ]
  }
  