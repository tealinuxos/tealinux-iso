{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/teaasciilite.txt"
        
    },
    "display": {
        
        "separator": "  ",
        "color": {
            "keys": "green"
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB"
        },
        "key": {
            "type": "icon"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "green",
                "at": "yellow",
                "host": "green"
            }
        },
        "os",
        "kernel",
        "de",
        "shell",
        "disk",
        "memory",
        "packages",
        "uptime",
        {
            "type": "colors",
            "key": "Colors", 
            "symbol": "circle"
        }
    ]
}
